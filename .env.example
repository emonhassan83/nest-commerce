# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL Connection URL
DATABASE_URL=postgresql://user:password@localhost:5432/nest_commerce?schema=public

# JWT Security
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key
JWT_REFRESH_EXPIRES_IN=7d

# ===============================
#  CORS Configuration
# ===============================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:3001

# ===============================
#  AWS S3 Credential
# ===============================
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET_NAME=
# Optional S3 / MinIO / Hetzner Configurations:
# S3_ENDPOINT=
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=false
# S3_OBJECT_ACL=none
